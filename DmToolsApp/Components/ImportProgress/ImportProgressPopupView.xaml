<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Components"
             x:Class="DmToolsApp.Components.ImportProgressPopupView"
             x:DataType="local:ImportProgressViewModel"
             BackgroundColor="Transparent">
    <Border Style="{StaticResource DialogCardBorder}" WidthRequest="320">
        <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="True"
                                   Color="{DynamicResource AppAccent}"
                                   WidthRequest="18" HeightRequest="18"
                                   VerticalOptions="Center"/>
                <Label Text="{Binding Title}"
                       FontAttributes="Bold" FontSize="{OnIdiom Default=16, Desktop=14}"
                       TextColor="{DynamicResource AppText}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Text="{Binding CurrentFileName}"
                   FontSize="{OnIdiom Default=14, Desktop=12}"
                   TextColor="{DynamicResource AppTextMuted}"
                   Style="{StaticResource TruncatedLabelStyle}"/>
            <Label Text="{Binding ProgressText}"
                   FontSize="{OnIdiom Default=14, Desktop=12}"
                   TextColor="{DynamicResource AppTextMuted}"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
