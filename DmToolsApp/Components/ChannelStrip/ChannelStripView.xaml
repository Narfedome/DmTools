<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmTools.Components.ChannelStripView"
             xmlns:components ="clr-namespace:DmTools.Components"
             xmlns:icons="clr-namespace:DmTools.Resources.Icons"  WidthRequest="50">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Bouton play/pause -->
        <components:FaIconButtonView Icon="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseConverter}}"
                                           Command="{Binding TogglePlayCommand}"
                                         Tooltip="{Binding IsPlaying, Converter={StaticResource BoolToTooltipPlayPauseConverter}}" Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Slider Minimum="0" Maximum="1"  Grid.Row="0"  Rotation="-90"   Value="{Binding Volume, Mode=TwoWay}"  VerticalOptions="Center"
    WidthRequest="150"/>
            <Label Text="{Binding DisplayVolume}"  Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Start"/>
        </Grid>
        <!-- Nom de la tranche -->
        <Label Text="{Binding Name}" Rotation="-90" VerticalOptions="Center" LineBreakMode="TailTruncation"   WidthRequest="100"  Grid.Row="2" />
    </Grid>
</ContentView>
