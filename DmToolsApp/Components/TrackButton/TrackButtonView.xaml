<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Components.TrackButtonView" x:Name="root"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons">
    <Grid>
        <!-- Placeholder toujours présent en arrière-plan, couvert par la pochette si elle existe -->
        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0"
                BackgroundColor="{DynamicResource AppBorder}">
            <Label Text="{x:Static icons:SolidFont.Music}"
                   FontFamily="FontSolid"
                   FontSize="28"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   TextColor="{DynamicResource AppTextMuted}"/>
        </Border>

        <components:FaIconButtonView x:Name="IconBtn"
            Icon="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseConverter}}"
            Command="{Binding TogglePlayCommand}"
            Tooltip="{Binding IsPlaying, Converter={StaticResource BoolToTooltipPlayPauseConverter}}"
            BackgroundColor="Transparent"
            BackgroundImage="{Binding CoverImage}" />
    </Grid>
</ContentView>
