<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Components.ScrollingLabelView"  x:Name="root">

    <!-- Le Clip est recalculé en code-behind (OnSizeChanged) à partir de la taille réelle du
         composant, pas figé en dur : ça permet de réutiliser ScrollingLabelView à n'importe
         quelle taille (ex. pivoté dans RotatedLabelView) sans risquer un décalage entre le Clip
         et le WidthRequest/HeightRequest effectivement posés par le consommateur. -->
    <Grid x:Name="RootGrid">
        <Label x:Name="ScrollingLabel"
               Text="{Binding Source={x:Reference root}, Path=Text}"
               TextColor="{Binding Source={x:Reference root}, Path=TextColor}"
               FontSize="{Binding Source={x:Reference root}, Path=FontSize}"
               LineBreakMode="{Binding Source={x:Reference root}, Path=LineBreakMode}"
               VerticalOptions="Center"
               HorizontalOptions="Start">            
        </Label>
    </Grid>
</ContentView>
