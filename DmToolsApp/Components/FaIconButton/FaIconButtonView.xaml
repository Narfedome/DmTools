<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Components.FaIconButtonView"  x:Name="root">

    <Grid>

        <!-- Background image -->
        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0">
        <Image
            Source="{Binding Source={x:Reference root}, Path=BackgroundImage}"
            Aspect="AspectFit" />
        </Border>

        <Button
        Text="{Binding Source={x:Reference root}, Path=Icon}"
        FontFamily="{Binding Source={x:Reference root}, Path=IconFont}"
        FontSize="{Binding Source={x:Reference root}, Path=IconSize}"
        TextColor="{Binding Source={x:Reference root}, Path=IconColor}"
        BackgroundColor="{DynamicResource AppAccent}"
        CornerRadius="{Binding Source={x:Reference root}, Path=CornerRadius}"
        Command="{Binding Source={x:Reference root}, Path=Command}"
        CommandParameter="{Binding Source={x:Reference root}, Path=CommandParameter}"
        ToolTipProperties.Text="{Binding Source={x:Reference root}, Path=Tooltip}"
        WidthRequest="44"
        HeightRequest="44"
        Padding="0"
        HorizontalOptions="Center" />

        <!-- Anneau de mise en évidence (tutoriel guidé) : superposé, ne capte aucun tap, pour ne
             jamais gêner le bouton qu'il entoure. -->
        <Border StrokeShape="RoundRectangle 12"
                Stroke="{DynamicResource AppAccent}"
                StrokeThickness="3"
                BackgroundColor="Transparent"
                Margin="-5"
                InputTransparent="True"
                IsVisible="{Binding Source={x:Reference root}, Path=IsHighlighted}"/>

    </Grid>
</ContentView>
