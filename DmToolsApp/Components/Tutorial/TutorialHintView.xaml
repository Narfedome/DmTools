<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             x:Class="DmToolsApp.Components.Tutorial.TutorialHintView"
             x:Name="root">

    <Border BackgroundColor="{DynamicResource AppAccent}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="0"
            Padding="12,10"
            Margin="0,0,0,8">
        <Grid ColumnSpacing="8" RowSpacing="2"
              ColumnDefinitions="*,auto"
              RowDefinitions="auto,auto">
            <Label Grid.Row="0" Grid.Column="0"
                   Text="{Binding Source={x:Reference root}, Path=TitleText}"
                   FontAttributes="Bold" FontSize="15" TextColor="White"/>
            <Label Grid.Row="1" Grid.Column="0"
                   Text="{Binding Source={x:Reference root}, Path=DescriptionText}"
                   FontSize="13" TextColor="White" Opacity="0.9"/>
            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                    Text="{x:Static icons:SolidFont.Xmark}"
                    FontFamily="FontSolid"
                    FontSize="14"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="6"
                    VerticalOptions="Start"
                    Command="{Binding Source={x:Reference root}, Path=SkipCommand}"/>
        </Grid>
    </Border>
</ContentView>
