<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             x:Class="DmToolsApp.Components.Tutorial.TutorialArrowView"
             x:Name="root">

    <Label x:Name="ArrowLabel"
           Text="{x:Static icons:SolidFont.ChevronDown}"
           FontFamily="FontSolid"
           FontSize="20"
           TextColor="{DynamicResource AppAccent}"
           HorizontalOptions="Center"
           IsVisible="{Binding Source={x:Reference root}, Path=IsActive}"/>
</ContentView>
