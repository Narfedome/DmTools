<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             xmlns:corevm="clr-namespace:DmToolsApp.Components;assembly=DmToolsApp.Core"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:local="clr-namespace:DmToolsApp.Features.AudioMixer"
             x:Class="DmToolsApp.Components.MixerChannelCardView"
             x:DataType="corevm:ChannelStripViewModel">

    <!-- IsEnabled global : le strip et ses boutons (livre/gear/X) restent désactivés tant que
         SON lecteur n'est pas prêt (IsLoading), sans dupliquer le binding sur chaque bouton. -->
    <Grid Margin="10" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 8"
                Stroke="{Binding IsPlaying, Converter={StaticResource BoolToActiveStrokeConverter}}"
                Padding="4">
            <Grid>
                <!-- Remplissage bas-vers-haut proportionnel au volume, dans la même couleur que le
                     contour "en lecture" (BoolToActiveStrokeConverter) : repère d'ambiance sur le
                     mix global d'un coup d'œil, sans jamais réduire la lisibilité du strip
                     au-dessus - contrairement à une opacité appliquée à toute la carte (écartée
                     après comparaison, cf. discussion avec l'utilisateur : ça ressemblait trop à un
                     canal désactivé à faible volume). InputTransparent : ne doit jamais intercepter
                     les gestes destinés au slider/aux boutons du strip par-dessus. -->
                <Grid InputTransparent="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding Volume, Converter={StaticResource VolumeToRowStarConverter}, ConverterParameter=Invert}"/>
                        <RowDefinition Height="{Binding Volume, Converter={StaticResource VolumeToRowStarConverter}}"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" StrokeThickness="0" Opacity="0.35"
                            Background="{Binding IsPlaying, Converter={StaticResource BoolToActiveStrokeConverter}}"/>
                </Grid>

                <components:ChannelStripView />

                <!-- Bandes de fade in (haut) / fade out (bas) : réglages persistés sur la piste de
                     scène (IsFadeIn/IsFadeOut), affichées indépendamment de la lecture en cours -
                     c'est une information de configuration, pas un état "en train de se produire". -->
                <Border VerticalOptions="Start" HeightRequest="18" StrokeThickness="0" InputTransparent="True"
                        IsVisible="{Binding IsFadeIn}"
                        Background="{Binding IsFadeIn, Converter={StaticResource FadeEdgeBrushConverter}}"/>
                <Border VerticalOptions="End" HeightRequest="18" StrokeThickness="0" InputTransparent="True"
                        IsVisible="{Binding IsFadeOut}"
                        Background="{Binding IsFadeOut, Converter={StaticResource FadeEdgeBrushConverter}, ConverterParameter=Bottom}"/>

                <!-- Lecture automatique au chargement de la scène (réglage persisté, cf. dialogue
                     de paramètres) : seul repère qui n'a pas d'équivalent dégradé/remplissage
                     pertinent (booléen simple), une icône reste plus explicite qu'une couleur ou
                     un motif à cette taille. -->
                <Label Text="{x:Static icons:SolidFont.Bolt}" FontFamily="FontSolid" FontSize="11"
                       TextColor="{DynamicResource AppAccent}"
                       HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0"
                       InputTransparent="True"
                       IsVisible="{Binding IsAutoPlay}"/>
            </Grid>
        </Border>
        <ActivityIndicator Grid.Row="0"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center" VerticalOptions="Center" />
        <Grid Grid.Row="1" RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Book}"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=PickLibraryItemCommand}"
                                     CommandParameter="{Binding .}" Grid.Row="0"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Gear}"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=OpenChannelSettingsCommand}"
                                     CommandParameter="{Binding .}"
                                     IsEnabled="{Binding HasSceneTrack}"
                                     Tooltip="{loc:Loc ChannelSettings}" Grid.Row="1"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Xmark}"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=RemoveChannelCommand}"
                                     CommandParameter="{Binding .}" Grid.Row="2"/>

            <!-- Poignée : seul point d'accroche du drag, sur toutes les plateformes (cf.
                 AudioMixerPage.xaml : le Drop reste sur toute la carte, une cible facile à
                 viser - sur Windows le drag souris démarre dès le mouvement, donc glisser depuis
                 n'importe où sur la carte déclencherait le drag par erreur en scrollant la liste
                 horizontale). -->
            <Border Grid.Row="3" HorizontalOptions="Center"
                    BackgroundColor="{DynamicResource AppSurface}"
                    Stroke="{DynamicResource AppBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    Padding="6,4">
                <Border.GestureRecognizers>
                    <DragGestureRecognizer CanDrag="True" DragStarting="OnDragStarting" DropCompleted="OnDropCompleted"/>
                </Border.GestureRecognizers>
                <Label Text="{x:Static icons:SolidFont.Grip}"
                       FontFamily="FontSolid" FontSize="{OnIdiom Default=13, Desktop=11}"
                       TextColor="{DynamicResource AppTextMuted}"/>
            </Border>
        </Grid>
    </Grid>
</ContentView>
