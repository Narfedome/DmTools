<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:loc="clr-namespace:DmToolsApp.Extensions"
               xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
               xmlns:components="clr-namespace:DmToolsApp.Components"
               xmlns:dialogs="clr-namespace:DmToolsApp.Components.Dialogs"
               x:TypeArguments="system:Boolean"
               x:Class="DmToolsApp.Components.Dialogs.TrackEditDialog"
               x:DataType="dialogs:TrackEditDialogViewModel"
               BackgroundColor="Transparent"
               Padding="0"
               VerticalOptions="Start"
               Margin="0,80,0,0">
    <!-- Même ancrage/raisons qu'CreateItemDialog (cf. ses commentaires) : ancré en haut plutôt que
         centré pour rester stable quand le clavier s'ouvre. -->
    <Border Style="{StaticResource DialogCardBorder}" WidthRequest="320">
        <ScrollView x:Name="ContentScroll" VerticalOptions="Start">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold" FontSize="16"
                   TextColor="{DynamicResource AppText}"
                   HorizontalOptions="Center"/>

            <components:TrackButtonView CurrentTrack="{Binding Item}" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc TrackImport}" FontSize="13" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:IconTextButton Grid.Column="1" Text="{Binding FileButtonText}" Command="{Binding PickFileCommand}"
                                                Icon="{x:Static icons:SolidFont.FileAudio}"
                                                FontSize="14" IconSize="14" TextColor="{DynamicResource AppAccent}"
                                                TextMaximumWidth="150"/>
                </Grid>
                <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc TrackTitlePh}" FontSize="13" TextColor="{DynamicResource AppTextMuted}"/>
                    <Label Grid.Column="1" Text="{Binding DurationText}" FontSize="13" TextColor="{DynamicResource AppTextMuted}"/>
                </Grid>
                <Entry Text="{Binding Name}" Placeholder="{loc:Loc TrackTitlePh}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Loc LibImportCategoryTitle}" FontSize="13" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Center"/>
                    <components:IconTextButton Grid.Column="1" Text="{Binding CategoryButtonText}" Command="{Binding SelectCategoryCommand}"
                                                Icon="{x:Static icons:SolidFont.Tags}"
                                                FontSize="14" IconSize="14" TextColor="{DynamicResource AppAccent}"
                                                TextMaximumWidth="150"/>
                </Grid>
                <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButton}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>
