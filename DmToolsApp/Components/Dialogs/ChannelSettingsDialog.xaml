<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:loc="clr-namespace:DmToolsApp.Extensions"
               x:TypeArguments="system:Boolean"
               x:Class="DmToolsApp.Components.Dialogs.ChannelSettingsDialog"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorder}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label Text="{loc:Loc ChannelSettings}"
                   FontAttributes="Bold" FontSize="16"
                   TextColor="{DynamicResource AppText}"/>
            <Label x:Name="TrackLabel"
                   FontSize="14"
                   TextColor="{DynamicResource AppTextMuted}"
                   LineBreakMode="TailTruncation"/>

            <!-- Volume -->
            <Grid ColumnDefinitions="auto,*,40" ColumnSpacing="10">
                <Label Text="{loc:Loc SceneVolume}" FontSize="14" VerticalOptions="Center"/>
                <Slider x:Name="VolumeSlider" Grid.Column="1"
                        Minimum="0" Maximum="1"
                        ValueChanged="OnVolumeChanged"/>
                <Label x:Name="VolumeValueLabel" Grid.Column="2"
                       FontSize="14" VerticalOptions="Center" HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Toggles -->
            <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto,auto" RowSpacing="4">
                <Label Grid.Row="0" Text="{loc:Loc ChannelLoop}" FontSize="14" VerticalOptions="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="LoopCheck"/>

                <Label Grid.Row="1" Text="{loc:Loc SceneFadeIn}" FontSize="14" VerticalOptions="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="FadeInCheck"/>

                <Label Grid.Row="2" Text="{loc:Loc SceneFadeOut}" FontSize="14" VerticalOptions="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="FadeOutCheck"/>

                <Label Grid.Row="3" Text="{loc:Loc SceneAuto}" FontSize="14" VerticalOptions="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="AutoPlayCheck"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="{loc:Loc BtnCancel}"
                        Style="{StaticResource DialogSecondaryButton}"
                        Clicked="OnCancelClicked"/>
                <Button Grid.Column="1"
                        Text="{loc:Loc BtnSave}"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
