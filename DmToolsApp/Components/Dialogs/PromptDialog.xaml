<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:system="clr-namespace:System;assembly=mscorlib"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:TypeArguments="system:String"
               x:Class="DmToolsApp.Components.Dialogs.PromptDialog"
               BackgroundColor="Transparent"
               Padding="0">
    <Border Style="{StaticResource DialogCardBorder}" WidthRequest="320">
        <VerticalStackLayout Spacing="16">
            <Label x:Name="TitleLabel"
                   FontAttributes="Bold" FontSize="16"
                   TextColor="{DynamicResource AppText}"/>
            <Label x:Name="MessageLabel"
                   FontSize="14"
                   TextColor="{DynamicResource AppTextMuted}"/>
            <Entry x:Name="InputEntry"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="CancelButton"
                        Grid.Column="0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Clicked="OnCancelClicked"/>
                <Button x:Name="OkButton"
                        Grid.Column="1"
                        Clicked="OnOkClicked"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
