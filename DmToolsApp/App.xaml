<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp"
             xmlns:converters="clr-namespace:DmToolsApp.Converters"
             x:Class="DmToolsApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToPlayPauseConverter x:Key="BoolToPlayPauseConverter"/>
            <converters:BoolToTooltipPlayPauseConverter x:Key="BoolToTooltipPlayPauseConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:BoolToActiveStrokeConverter x:Key="BoolToActiveStrokeConverter" />
            <converters:BoolToTutorialHighlightConverter x:Key="BoolToTutorialHighlightConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
