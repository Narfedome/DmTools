<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DmToolsApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:audioMixer="clr-namespace:DmToolsApp.Features.AudioMixer"
    xmlns:library="clr-namespace:DmToolsApp.Features.Library"
    xmlns:local="clr-namespace:DmToolsApp"
    xmlns:extensions="clr-namespace:DmToolsApp.Extensions"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
    Title="DmToolsApp">
    <TabBar>
  
        <Tab Title="AudioMixer"
             Icon="{extensions:FaIcon Glyph={x:Static  icons:SolidFont.Sliders}}" >
            <ShellContent ContentTemplate="{DataTemplate audioMixer:AudioMixerView}" />
       </Tab>  
        <Tab Title="Home" 
             Icon="{extensions:FaIcon Glyph={x:Static  icons:SolidFont.House}}" >
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"   Route="InitialPage"/>
        </Tab>
        <Tab Title="Library"
             Icon="{extensions:FaIcon Glyph={x:Static  icons:SolidFont.BookOpen}}" >
            <ShellContent ContentTemplate="{DataTemplate library:LibraryView}" />
       </Tab>
    </TabBar>

</Shell>
