<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.AudioMixer"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             xmlns:corevm="clr-namespace:DmToolsApp.Components;assembly=DmToolsApp.Core"
             xmlns:models="clr-namespace:DmToolsApp.Models"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             x:Class="DmToolsApp.Features.AudioMixer.AudioMixerPage"
             x:DataType="local:AudioMixerViewModel">

    <components:WatermarkedLayout>
    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:MixerSceneSelectorView Grid.Row="0" />

        <components:MixerGlobalControlsView Grid.Row="1" />

        <!-- Overlay de chargement de scène : couvre toute la page (fond semi-transparent) pendant
             la (re)création des channel strips. Le CollectionView étant un contrôle natif sur
             Windows, l'ordre visuel (ZIndex) ne suffit pas à bloquer ses interactions : chaque
             zone interactive est donc aussi désactivée via IsEnabled, en plus du blocage de la
             navigation Shell côté ViewModel. -->
        <Grid Grid.RowSpan="3"
              ZIndex="10"
              IsVisible="{Binding Loading.IsLoading}"
              BackgroundColor="{StaticResource AppOverlay}">
            <ActivityIndicator IsRunning="{Binding Loading.IsLoading}"
                               VerticalOptions="Center" HorizontalOptions="Center"
                               WidthRequest="120" HeightRequest="120"/>
        </Grid>

        <!-- Channels -->
        <Border Grid.Row="2"
                IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView x:Name="ChannelsCollectionView" ItemsSource="{Binding CurrentChannels}" ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="corevm:ChannelStripViewModel">
                        <!-- Drag restreint à la poignée (cf. plus bas), sur toutes les plateformes :
                             sur Windows le drag souris démarre dès le mouvement (pas d'appui long
                             ni de délai configurable), donc glisser depuis n'importe où sur la
                             carte déclenchait le drag par erreur en scrollant la liste horizontale.
                             Le Drop reste sur toute la carte (cible facile à viser). -->
                        <Grid>
                            <Grid.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True" Drop="OnChannelDrop" DragOver="OnChannelDragOver" DragLeave="OnChannelDragLeave"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Enveloppe visuelle de la carte : remplissage bas-vers-haut proportionnel
                                 au volume (VolumeToRowStarConverter), dans la même couleur que l'ancien
                                 contour "en lecture" (BoolToActiveStrokeConverter, donc transparent hors
                                 lecture) - repère d'ambiance sur le mix global d'un coup d'œil, sans
                                 réduire la lisibilité du contenu au-dessus. Une opacité appliquée à
                                 toute la carte a été écartée après comparaison : ça ressemblait trop à
                                 un canal désactivé à faible volume (cf. discussion avec l'utilisateur).
                                 Ici, au niveau du DataTemplate plutôt que dans MixerChannelCardView, pour
                                 que ça couvre toute la carte (boutons compris) et reste au même niveau
                                 que DragHighlightBorder, qui joue un rôle décoratif similaire. -->
                            <Border Grid.Column="0" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                    Stroke="{DynamicResource AppBorder}">
                                <Grid>
                                    <Grid InputTransparent="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Volume, Converter={StaticResource VolumeToRowStarConverter}, ConverterParameter=Invert}"/>
                                            <RowDefinition Height="{Binding Volume, Converter={StaticResource VolumeToRowStarConverter}}"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" StrokeThickness="0" Opacity="0.35"
                                                Background="{Binding IsPlaying, Converter={StaticResource BoolToActiveStrokeConverter}}"/>
                                    </Grid>

                                    <!-- Bandes de fade in (haut) / fade out (bas) : réglages persistés
                                         sur la piste de scène (IsFadeIn/IsFadeOut), affichées
                                         indépendamment de la lecture en cours - une information de
                                         configuration, pas un état "en train de se produire". -->
                                    <Border VerticalOptions="Start" HeightRequest="18" StrokeThickness="0" InputTransparent="True"
                                            IsVisible="{Binding IsFadeIn}"
                                            Background="{Binding IsFadeIn, Converter={StaticResource FadeEdgeBrushConverter}}"/>
                                    <Border VerticalOptions="End" HeightRequest="18" StrokeThickness="0" InputTransparent="True"
                                            IsVisible="{Binding IsFadeOut}"
                                            Background="{Binding IsFadeOut, Converter={StaticResource FadeEdgeBrushConverter}, ConverterParameter=Bottom}"/>

                                    <!-- Lecture automatique au chargement de la scène (réglage persisté) :
                                         seul repère sans équivalent dégradé/remplissage pertinent (booléen
                                         simple), une icône reste plus explicite qu'une couleur à cette taille. -->
                                    <Label Text="{x:Static icons:SolidFont.Bolt}" FontFamily="FontSolid" FontSize="11"
                                           TextColor="{DynamicResource AppAccent}"
                                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0"
                                           InputTransparent="True"
                                           IsVisible="{Binding IsAutoPlay}"/>

                                    <components:MixerChannelCardView />
                                </Grid>
                            </Border>
                            <!-- Encadré décoratif superposé, affiché pendant le glisser-déposer (cf.
                                 AudioMixerPage.xaml.cs) : indépendant du remplissage/des bandes
                                 ci-dessus, pour ne jamais entrer en conflit avec ces indicateurs.
                                 InputTransparent : n'intercepte jamais les gestes destinés au contenu
                                 en-dessous (Play/Stop, slider, boutons). -->
                            <Border x:Name="DragHighlightBorder" Grid.Column="0"
                                    BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8" InputTransparent="True"/>
                            <BoxView Grid.Column="1"
                                     Color="Gray"
                                     WidthRequest="1"
                                     VerticalOptions="Fill" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
