<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.AudioMixer"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             xmlns:corevm="clr-namespace:DmToolsApp.Components;assembly=DmToolsApp.Core"
             xmlns:models="clr-namespace:DmToolsApp.Models"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             x:Class="DmToolsApp.Features.AudioMixer.AudioMixerPage"
             x:DataType="local:AudioMixerViewModel">

    <components:WatermarkedLayout>
    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de sélection de scène -->
        <Border Grid.Row="0" Padding="10"
                IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <!-- Grid sans lignes/colonnes déclarées : les deux enfants remplissent la même cellule
                 et se superposent - seul celui dont IsVisible est vrai est réellement affiché, donc
                 pas de chevauchement à l'écran. Évite de garder les 5 colonnes normales avec des
                 éléments juste masqués (les colonnes "auto"/"*" vides laisseraient un grand espace
                 mort autour du picker restant plutôt qu'un layout recentré proprement). -->
            <Grid>

                <!-- Mode normal (une vraie scène chargée) : chapitre + précédent/suivant + scène.
                     Le bouton "sans scène" vit désormais sur la ligne Global (cf. plus bas) : il
                     mangeait trop de place ici et forçait les noms de chapitre/scène à tronquer
                     plus vite qu'avant son ajout. -->
                <Grid ColumnSpacing="8" IsVisible="{Binding IsFreeformActive, Converter={StaticResource InverseBoolConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextMaximumWidth : sans borne (défaut = infini), un titre de session/scène long
                         déborde de sa colonne "*" et chevauche son voisin au lieu d'être tronqué (le
                         composant gère déjà LineBreakMode="TailTruncation" en interne, encore fallait-il
                         lui donner une largeur à respecter). -->
                    <components:IconTextButton Grid.Column="0" HorizontalOptions="Center"
                            Icon="{x:Static icons:SolidFont.Bookmark}" IconSize="13"
                            Text="{Binding SelectedSessionLabel}"
                            Command="{Binding SelectSessionCommand}"
                            TextColor="{DynamicResource AppAccent}"
                            TextMaximumWidth="{OnPlatform Default=100, WinUI=200}"
    />

                    <!-- Style Ghost : un chevron de navigation est une action secondaire, il ne doit
                         pas rivaliser visuellement avec les pickers (cf. même usage sur les chevrons
                         de l'accordéon Campagnes). -->
                    <components:FaIconButtonView Grid.Column="1"
                            Style="{StaticResource GhostIconButtonStyle}"
                            Icon="{x:Static icons:SolidFont.ChevronLeft}"
                            Command="{Binding PrevSceneCommand}"
                            IsEnabled="{Binding CanGoPrevScene}"
                            Tooltip="{loc:Loc MixerPrevScene}" />

                    <components:IconTextButton Grid.Column="2" HorizontalOptions="Center"
                            Icon="{x:Static icons:SolidFont.MasksTheater}" IconSize="13"
                            Text="{Binding SelectedSceneLabel}"
                            Command="{Binding SelectSceneCommand}"
                            TextColor="{DynamicResource AppAccent}"
                            TextMaximumWidth="{OnPlatform Default=100, WinUI=200}"
    />

                    <components:FaIconButtonView Grid.Column="3"
                            Style="{StaticResource GhostIconButtonStyle}"
                            Icon="{x:Static icons:SolidFont.ChevronRight}"
                            Command="{Binding NextSceneCommand}"
                            IsEnabled="{Binding CanGoNextScene}"
                            Tooltip="{loc:Loc MixerNextScene}" />
                </Grid>

                <!-- Mode "sans scène" : un seul picker centré (chapitre et scène déclenchent de
                     toute façon la même chaîne de sélection tant qu'aucun chapitre n'est choisi, cf.
                     AudioMixerViewModel.SelectScene), pas de flèches prev/next (rien à parcourir). -->
                <components:IconTextButton HorizontalOptions="Center"
                        Icon="{x:Static icons:SolidFont.Bolt}" IconSize="13"
                        Text="{Binding SelectedSessionLabel}"
                        Command="{Binding SelectSessionCommand}"
                        TextColor="{DynamicResource AppAccent}"
                        IsVisible="{Binding IsFreeformActive}" />
            </Grid>
        </Border>

        <!-- Global Commands + Add -->
        <Grid Grid.Row="1" Padding="10" ColumnSpacing="15"
              IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <HorizontalStackLayout Spacing="10" Margin="10">
                    <Label Text="{loc:Loc MixerGlobal}" VerticalOptions="Center"/>
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Play}"
                                                 Command="{Binding PlayAllCommand}"
                                                 Tooltip="{loc:Loc MixerPlayAll}" />
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.VolumeXmark}"
                                                 Command="{Binding FadeOutAllCommand}"
                                                 Tooltip="{loc:Loc MixerFadeOutAll}" />
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Stop}"
                                                 Command="{Binding StopAllCommand}"
                                                 Tooltip="{loc:Loc MixerStopAll}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Bascule sur la scène orpheline (sans campagne/chapitre) : utiliser le Mixer sans
                 jamais passer par l'accordéon. Repositionné ici (colonne "*" jusque-là vide) plutôt
                 que dans la barre de sélection : il y mangeait trop de place et forçait les noms de
                 chapitre/scène à tronquer plus vite. Masqué une fois qu'on est déjà en mode "sans
                 scène" (IsFreeformActive) : rebasculer dessus n'a pas de sens tant qu'on n'en est
                 pas sorti. -->
            <components:FaIconButtonView Grid.Column="1" HorizontalOptions="End"
                     Icon="{x:Static icons:SolidFont.Bolt}"
                     Command="{Binding SelectFreeformSceneCommand}"
                     IsVisible="{Binding IsFreeformActive, Converter={StaticResource InverseBoolConverter}}"
                     Tooltip="{loc:Loc MixerFreeform}" />

            <components:FaIconButtonView Grid.Column="2"
                     Icon="{x:Static icons:SolidFont.Plus}"
                     Command="{Binding AddChannelCommand}"
                     IsEnabled="{Binding HasActiveScene}"
                     Tooltip="{loc:Loc BtnAddChannel}" />
        </Grid>

        <!-- Overlay de chargement de scène : couvre toute la page (fond semi-transparent) pendant
             la (re)création des channel strips. Le CollectionView étant un contrôle natif sur
             Windows, l'ordre visuel (ZIndex) ne suffit pas à bloquer ses interactions : chaque
             zone interactive est donc aussi désactivée via IsEnabled, en plus du blocage de la
             navigation Shell côté ViewModel. -->
        <Grid Grid.RowSpan="3"
              ZIndex="10"
              IsVisible="{Binding Loading.IsLoading}"
              BackgroundColor="{StaticResource AppOverlay}">
            <ActivityIndicator IsRunning="{Binding Loading.IsLoading}"
                               VerticalOptions="Center" HorizontalOptions="Center"
                               WidthRequest="120" HeightRequest="120"/>
        </Grid>

        <!-- Channels -->
        <Border Grid.Row="2"
                IsEnabled="{Binding Loading.IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView x:Name="ChannelsCollectionView" ItemsSource="{Binding CurrentChannels}" ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="corevm:ChannelStripViewModel">
                        <!-- Drag restreint à la poignée (cf. plus bas), sur toutes les plateformes :
                             sur Windows le drag souris démarre dès le mouvement (pas d'appui long
                             ni de délai configurable), donc glisser depuis n'importe où sur la
                             carte déclenchait le drag par erreur en scrollant la liste horizontale.
                             Le Drop reste sur toute la carte (cible facile à viser). -->
                        <Grid>
                            <Grid.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True" Drop="OnChannelDrop" DragOver="OnChannelDragOver" DragLeave="OnChannelDragLeave"/>
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- IsEnabled global : le strip et ses boutons (livre/gear/X) restent
                                 désactivés tant que SON lecteur n'est pas prêt (IsLoading), sans
                                 dupliquer le binding sur chaque bouton. -->
                            <Grid Grid.Column="0" Margin="10"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{Binding IsPlaying, Converter={StaticResource BoolToActiveStrokeConverter}}"
                                        Padding="4">
                                    <components:ChannelStripView />
                                </Border>
                                <ActivityIndicator Grid.Row="0"
                                        IsRunning="{Binding IsLoading}"
                                        IsVisible="{Binding IsLoading}"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                <Grid Grid.Row="1" RowSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Book}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=PickLibraryItemCommand}"
                                                             CommandParameter="{Binding .}" Grid.Row="0"/>
                                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Gear}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=OpenChannelSettingsCommand}"
                                                             CommandParameter="{Binding .}"
                                                             IsEnabled="{Binding HasSceneTrack}"
                                                             Tooltip="{loc:Loc ChannelSettings}" Grid.Row="1"/>
                                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Xmark}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:AudioMixerViewModel}}, Path=RemoveChannelCommand}"
                                                             CommandParameter="{Binding .}" Grid.Row="2"/>

                                    <!-- Poignée : seul point d'accroche du drag (cf. commentaire sur le Grid racine) -->
                                    <Border Grid.Row="3" HorizontalOptions="Center"
                                            BackgroundColor="{DynamicResource AppSurface}"
                                            Stroke="{DynamicResource AppBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,4">
                                        <Border.GestureRecognizers>
                                            <DragGestureRecognizer CanDrag="True" DragStarting="OnChannelDragStarting" DropCompleted="OnChannelDropCompleted"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static icons:SolidFont.Grip}"
                                               FontFamily="FontSolid" FontSize="{OnIdiom Default=13, Desktop=11}"
                                               TextColor="{DynamicResource AppTextMuted}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- Encadré décoratif superposé, affiché pendant le glisser-déposer (cf.
                                 AudioMixerPage.xaml.cs) : indépendant du Border du strip lui-même
                                 (Stroke déjà piloté par IsPlaying), pour ne jamais entrer en conflit
                                 avec cet indicateur. InputTransparent : n'intercepte jamais les gestes
                                 destinés au contenu en-dessous (Play/Stop, slider, boutons). -->
                            <Border x:Name="DragHighlightBorder" Grid.Column="0"
                                    BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8" InputTransparent="True"/>
                            <BoxView Grid.Column="1"
                                     Color="Gray"
                                     WidthRequest="1"
                                     VerticalOptions="Fill" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
