<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             x:Class="DmToolsApp.Features.Library.CategoryListPage"
             x:DataType="local:CategoryListViewModel"
             Shell.NavBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False"/>
    </Shell.BackButtonBehavior>
    <components:WatermarkedLayout>
        <Grid RowDefinitions="auto,*">
            <components:DetailPageHeaderView Grid.Row="0" x:Name="Header" Title="{loc:Loc CategoriesHeader}"
                BackCommand="{Binding BackCommand}"/>


            <Grid Grid.Row="1" Padding="10,0,10,10" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <ActivityIndicator Grid.Row="1" Grid.RowSpan="2" IsRunning="{Binding Loading.IsLoading}"
                           IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="80" HeightRequest="80"/>

                <CollectionView Grid.Row="1" x:Name="CategoryCollection"
                        ItemsSource="{Binding CategoryNames}"
                        SelectedItem="{Binding SelectedCategory}"
                        SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:CategoryRowItem">
                            <!-- Padding sur ce Grid englobant (pas Margin sur le Border racine) : même bug
                         Windows que CampaignPage (cf. son commentaire sur SessionTemplate/CampaignTemplate)
                         - le Margin de la racine d'un DataTemplate de CollectionView n'est pas fiable
                         sur Windows, la ligne suivante n'était donc jamais réellement espacée. -->
                            <Grid Padding="0,0,0,8">
                                <Border Style="{StaticResource RowBorderStyle}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="Grey"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSectionTitle}" VerticalOptions="Center" Style="{StaticResource TruncatedLabelStyle}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0,8">
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateCommand}"
                                         Tooltip="{loc:Loc LibAdd}"/>
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding RenameCommand}"
                                         Tooltip="{loc:Loc BtnRename}"
                                         IsEnabled="{Binding SelectedCategoryName, Converter={StaticResource IsNotNullConverter}}"/>
                    <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         IsEnabled="{Binding SelectedCategoryName, Converter={StaticResource IsNotNullConverter}}"/>
                </HorizontalStackLayout>
        </Grid>
        </Grid>
    </components:WatermarkedLayout>
</ContentPage>
