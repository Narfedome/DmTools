<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibrarySpellView"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             x:Name="root"      >

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <CollectionView
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding SpellItems}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedSpellItem}"  ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="Grey" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="LightSkyBlue" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid WidthRequest="120" HeightRequest="120" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:LibraryItemImageView
                                Grid.Row="0"
                                ImagePath="{Binding ImagePath}"
                                DefaultGlyph="{x:Static  icons:SolidFont.Meteor}"
                                Padding="20" />
                            <Label Text="{Binding Title}"
                                   Grid.Row="1"
                                   Style="{StaticResource TruncatedLabelStyle}"
                                   HorizontalOptions="Center"
                                   Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD) -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateItemCommand}"
                                         Tooltip="{loc:Loc LibAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditItemCommand}"
                                         Tooltip="{loc:Loc LibEdit}"
                                         IsEnabled="{Binding SelectedSpellItem, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteItemCommand}"
                                         Tooltip="{loc:Loc LibDelete}"
                                         IsEnabled="{Binding SelectedSpellItem, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Row="1"
                            HorizontalOptions="Center"
                            Spacing="20"
                            IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleCheck}"
                                           Command="{Binding ConfirmSelectionCommand}"
                                           Tooltip="{loc:Loc LibConfirm}"/>
            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleXmark}"
                                           Command="{Binding CancelCommand}"
                                           Tooltip="{loc:Loc LibCancel}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentView>
