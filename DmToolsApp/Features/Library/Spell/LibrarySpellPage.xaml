<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibrarySpellPage"
             xmlns:views="clr-namespace:DmToolsApp.Features.Library"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             x:DataType="local:LibrarySpellViewModel">

    <Shell.TitleView>
        <Label Text="{loc:Loc TabLibrary}"
               FontSize="18" FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{DynamicResource AppTextPrimary}"/>
    </Shell.TitleView>

    <views:LibrarySpellView IsCrud="True" />
</ContentPage>