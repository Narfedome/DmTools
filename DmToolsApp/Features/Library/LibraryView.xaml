<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryView"   
             xmlns:selectors="clr-namespace:DmToolsApp.Selectors"
             x:Name="root"      >

    <ContentView.Resources>
        <selectors:LibraryItemTemplateSelector x:Key="LibraryTemplateSelector"
    SpellTemplate="{StaticResource SpellTemplate}"
    TrackTemplate="{StaticResource TrackTemplate}" />
        <!-- Template pour Spell -->
        <DataTemplate x:Key="SpellTemplate">

            <Border 
        StrokeThickness="2" StrokeShape="RoundRectangle 5">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">

                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="Grey" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="LightSkyBlue" />
                                <Setter Property="StrokeThickness" Value="3" />
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid HorizontalOptions="Center" VerticalOptions="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <!-- Image pour Spell -->
                    <Image Source="{Binding ImagePath}"
                       
                WidthRequest="120"
                HeightRequest="120"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                    <Label Text="{Binding Title}"
                           Grid.Row="1" LineBreakMode="TailTruncation"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template pour Track -->
        <DataTemplate x:Key="TrackTemplate">
            <Border 
StrokeThickness="2" StrokeShape="RoundRectangle 5">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">

                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="Grey" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="LightSkyBlue" />
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding ImagePath}"
                 
          WidthRequest="120"
          HeightRequest="120"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"/>
                    <!-- Label au lieu de l'image -->
                    <Label Text="{Binding Title}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" LineBreakMode="TailTruncation"
                               Grid.Row="1"/>

                </Grid>
            </Border>
        </DataTemplate>

    </ContentView.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <CollectionView
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding LibraryItems}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedLibraryItem}"  ItemSizingStrategy="MeasureFirstItem" 
                 ItemTemplate="{StaticResource LibraryTemplateSelector}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD) -->
        <Grid  Grid.Row="1"  HorizontalOptions="Center" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Text="Add" Command="{Binding CreateItemCommand}" Grid.Column="0" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="Edit" Command="{Binding EditItemCommand}" Grid.Column="1" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="Delete" Command="{Binding DeleteItemCommand}" Grid.Column="2"  Margin="10,0,10,0" WidthRequest="85"/>
        </Grid>
        <Grid  Grid.Row="1" HorizontalOptions="Center" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud,  Converter={StaticResource InverseBoolConverter}}" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="*"/>
                <ColumnDefinition  Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Text="Cancel" Command="{Binding CancelCommand}"  Grid.Column="0" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="Confirm" Command="{Binding ConfirmSelectionCommand}"  Grid.Column="1" Margin="10,0,10,0" WidthRequest="85"/>
        </Grid>

    </Grid>
</ContentView>
