<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryView"   
             xmlns:selectors="clr-namespace:DmToolsApp.Selectors"
             x:Name="root"      >

    <ContentView.Resources>
        <selectors:LibraryItemTemplateSelector x:Key="LibraryTemplateSelector"
    SpellTemplate="{StaticResource SpellTemplate}"
    TrackTemplate="{StaticResource TrackTemplate}" />
        <!-- Template pour Spell -->
        <DataTemplate x:Key="SpellTemplate">
            <Grid>
                <Border
                WidthRequest="120"
                HeightRequest="120"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <!-- Image pour Spell -->
                        <Image Source="{Binding ImagePath}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                        <Label Text="{Binding Title}"
                           Grid.Row="1"
                           HorizontalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template pour Track -->
        <DataTemplate x:Key="TrackTemplate">
            <Grid>
                <Border
                WidthRequest="120"
                HeightRequest="120"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 5">
                    <Grid VerticalOptions="Center" HorizontalOptions="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Label Text="Track"      Grid.Row="0"/>
                        <!-- Label au lieu de l'image -->
                        <Label Text="{Binding Title}"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"     Grid.Row="1"/>

                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

    </ContentView.Resources>












    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <CollectionView
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding LibraryItems}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedLibraryItem}"  ItemSizingStrategy="MeasureFirstItem" 
                 ItemTemplate="{StaticResource LibraryTemplateSelector}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="15" HorizontalItemSpacing="15" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD) -->
        <Grid  Grid.Row="1"  HorizontalOptions="Center" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Text="Add" Command="{Binding AddItemCommand}" Grid.Column="0" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="Delete" Command="{Binding DeleteItemCommand}" Grid.Column="1"  Margin="10,0,10,0" WidthRequest="85"/>
        </Grid>
        <Grid  Grid.Row="1" HorizontalOptions="Center" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud,  Converter={StaticResource InverseBoolConverter}}" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="*"/>
                <ColumnDefinition  Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Text="Cancel" Command="{Binding CancelCommand}"  Grid.Column="0" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="Confirm" Command="{Binding ConfirmSelectionCommand}"  Grid.Column="1" Margin="10,0,10,0" WidthRequest="85"/>
        </Grid>

    </Grid>
</ContentView>
