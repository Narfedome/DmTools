<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryTrackView"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             x:Name="root"      >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <CollectionView
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding TrackItems}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedTrackItem}"  ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="Grey" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="LightSkyBlue" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid WidthRequest="120" HeightRequest="120"  Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:TrackButtonView    CurrentTrack="{Binding .}"
                                                           SelectCommand="{Binding Source={x:Reference root}, Path=BindingContext.SelectItemCommand}" />
                            <!-- Label au lieu de l'image -->
                            <Label Text="{Binding Title}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" LineBreakMode="TailTruncation"
                        Grid.Row="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD) -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateItemCommand}"
                                         Tooltip="{loc:Loc LibAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.FileImport}"
                                         Command="{Binding ImportMultipleTracksCommand}"
                                         Tooltip="{loc:Loc LibImport}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditItemCommand}"
                                         Tooltip="{loc:Loc LibEdit}"
                                         IsEnabled="{Binding SelectedTrackItem, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteItemCommand}"
                                         Tooltip="{loc:Loc LibDelete}"
                                         IsEnabled="{Binding SelectedTrackItem, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>
        <Grid  Grid.Row="1" HorizontalOptions="Center" IsVisible="{Binding Source={x:Reference root}, Path=IsCrud,  Converter={StaticResource InverseBoolConverter}}" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="*"/>
                <ColumnDefinition  Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Text="{loc:Loc LibConfirm}" Command="{Binding ConfirmSelectionCommand}"  Grid.Column="0" Margin="10,0,10,0" WidthRequest="85"/>
            <Button Text="{loc:Loc LibCancel}" Command="{Binding CancelCommand}"  Grid.Column="1" Margin="10,0,10,0" WidthRequest="85"/>
        </Grid>

    </Grid>
</ContentView>
