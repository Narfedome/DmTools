<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryTrackView"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             x:Name="root"      >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Picker Grid.Row="0"
                Margin="0,0,0,8"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"/>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Loading.IsLoading}" IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="120" HeightRequest="120"/>

        <CollectionView
                 Grid.Row="1"
                 x:Name="ItemsCollection"
                 ItemsSource="{Binding TrackItems}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedTrackItem}"  ItemSizingStrategy="MeasureFirstItem"
                 Scrolled="OnCollectionViewScrolled"
                 ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="3" VerticalItemSpacing="5" HorizontalItemSpacing="5" Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Margin="0,10"
                                   HeightRequest="30"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="Grey" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="LightSkyBlue" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid WidthRequest="120" HeightRequest="120"  Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <components:TrackButtonView    CurrentTrack="{Binding .}"
                                                           SelectCommand="{Binding Source={x:Reference root}, Path=BindingContext.SelectItemCommand}" />
                            <!-- Case à cocher pour la sélection multiple (visible uniquement en mode CRUD) -->
                            <CheckBox Grid.Row="0"
                                      IsChecked="{Binding IsSelected}"
                                      IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}"
                                      HorizontalOptions="Start" VerticalOptions="Start"/>
                            <!-- Label au lieu de l'image -->
                            <Label Text="{Binding Title}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" LineBreakMode="TailTruncation"
                        Grid.Row="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Boutons CRUD (visibles uniquement en mode CRUD) -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0,8"
                               IsVisible="{Binding Source={x:Reference root}, Path=IsCrud}">
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                         Command="{Binding CreateItemCommand}"
                                         Tooltip="{loc:Loc LibAdd}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.FileImport}"
                                         Command="{Binding ImportMultipleTracksCommand}"
                                         Tooltip="{loc:Loc LibImport}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Tags}"
                                         Command="{Binding ManageCategoriesCommand}"
                                         Tooltip="{loc:Loc LibManageCategories}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding EditItemCommand}"
                                         Tooltip="{loc:Loc LibEdit}"
                                         IsEnabled="{Binding SelectedTrackItem, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.CheckDouble}"
                                         Command="{Binding SelectAllCommand}"
                                         Tooltip="{loc:Loc LibSelectAll}"
                                         IsEnabled="{Binding HasTrackItems}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteSelectedItemsCommand}"
                                         Tooltip="{Binding DeleteTooltip}"
                                         IsEnabled="{Binding CanDelete}"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Grid.Row="2"
                            HorizontalOptions="Center"
                            Spacing="20"
                            IsVisible="{Binding Source={x:Reference root}, Path=IsCrud, Converter={StaticResource InverseBoolConverter}}">
            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleCheck}"
                                           Command="{Binding ConfirmSelectionCommand}"
                                           Tooltip="{loc:Loc LibConfirm}"/>
            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleXmark}"
                                           Command="{Binding CancelCommand}"
                                           Tooltip="{loc:Loc LibCancel}"/>

        </HorizontalStackLayout>
    </Grid>
</ContentView>
