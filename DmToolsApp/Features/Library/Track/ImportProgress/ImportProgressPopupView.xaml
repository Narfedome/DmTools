<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.Library"
             x:Class="DmToolsApp.Features.Library.ImportProgressPopupView"
             x:DataType="local:ImportProgressViewModel"
             BackgroundColor="Transparent">
    <Border BackgroundColor="{DynamicResource AppSurface}"
            Stroke="{DynamicResource AppBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="20"
            WidthRequest="320">
        <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="True"
                                   Color="{DynamicResource AppAccent}"
                                   WidthRequest="18" HeightRequest="18"
                                   VerticalOptions="Center"/>
                <Label Text="{Binding Title}"
                       FontAttributes="Bold" FontSize="16"
                       TextColor="{DynamicResource AppText}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Text="{Binding CurrentFileName}"
                   FontSize="14"
                   TextColor="{DynamicResource AppTextMuted}"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"/>
            <Label Text="{Binding ProgressText}"
                   FontSize="14"
                   TextColor="{DynamicResource AppTextMuted}"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
