<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryTrackEditPage"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:components="clr-namespace:DmToolsApp.Components">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid RowSpacing="15" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Text="{Binding Title}" FontSize="20" HorizontalOptions="Center" Margin="0,0,0,20"/>
                <components:TrackButtonView  Grid.Row="1" CurrentTrack="{Binding Item}"  WidthRequest="120" HeightRequest="120"/>
            </Grid>
            <HorizontalStackLayout Grid.Row="2" Spacing="15">  
                <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.FileImport}" Grid.Column="1"
                                  Command="{Binding PickFileCommand}"
                                Tooltip="Import"/>
                <Label  Text="{Binding ImportedFilePath}"  VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Grid Grid.Row="3"  RowSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Entry Grid.Row="0" Text="{Binding Item.Title}" Placeholder="Title"/>
                <Label Grid.Row="1" Text="{Binding Item.DurationFormatted}"/>
            </Grid>
        </Grid>
        <HorizontalStackLayout Grid.Row="1"
                            HorizontalOptions="Center"
                            Spacing="20">


         
            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.FloppyDisk}"
                                           Command="{Binding SaveCommand}"
                                         Tooltip="Save"/>


            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.Stop}"
                                           Command="{Binding CancelCommand}"
                                         Tooltip="Cancel"/>

        </HorizontalStackLayout>
    </Grid>

</ContentPage>
