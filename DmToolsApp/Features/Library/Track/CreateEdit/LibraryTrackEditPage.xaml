<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.LibraryTrackEditPage"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:components="clr-namespace:DmToolsApp.Components">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <components:LibraryItemImageView Grid.Row="0" ImagePath="{Binding ImagePath}" DefaultGlyph="{x:Static  icons:SolidFont.Music}" MaximumHeightRequest="30" />
            <Label Grid.Row="1" Text="Edit Track" FontSize="Large" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <components:FaIconButtonView Grid.Row="2"  Icon="{x:Static  icons:SolidFont.FileImport}"
                                           Command="{Binding PickFileCommand}"
                                         Tooltip="Save"/>
            <Grid Grid.Row="3"  RowSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Entry Grid.Row="0" Text="{Binding Item.Title}" Placeholder="Title"/>
                <Entry Grid.Row="1" Text="{Binding Item.FilePath}"  />
                <Entry Grid.Row="2" Text="{Binding Item.Duration}" />
            </Grid>
        </Grid>
        <HorizontalStackLayout Grid.Row="1"
                            HorizontalOptions="Center"
                            Spacing="20">


            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.FloppyDisk}"
                                           Command="{Binding SaveCommand}"
                                         Tooltip="Save"/>


            <components:FaIconButtonView Icon="{x:Static  icons:SolidFont.CircleMinus}"
                                           Command="{Binding CancelCommand}"
                                         Tooltip="Cancel"/>

        </HorizontalStackLayout>
    </Grid>

</ContentPage>
