<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DmToolsApp.Features.Library.CreateEdit.LibrarySpellEditView"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:components="clr-namespace:DmToolsApp.Components">
    <VerticalStackLayout>

        <components:LibraryItemImageView ImagePath="{Binding ImagePath}" DefaultGlyph="{x:Static  icons:SolidFont.BookOpen}"/>
        <Label Text="Edit Spell" FontSize="Large" HorizontalOptions="Center" Margin="0,0,0,20"/>
        <Entry Text="{Binding Item.Title}"  />
        <Editor Text="{Binding Item.Description}" />
    </VerticalStackLayout>    
</ContentView>
