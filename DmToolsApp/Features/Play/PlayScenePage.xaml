<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.Play"
             xmlns:models="clr-namespace:DmToolsApp.Models"
             x:Class="DmToolsApp.Features.Play.PlayScenePage"
             x:DataType="local:PlaySceneViewModel"
             Title="{Binding Session.Title}">

    <Shell.TitleView>
        <Label Text="{Binding Session.Title}"
               FontSize="18" FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{DynamicResource AppTextPrimary}"/>
    </Shell.TitleView>

    <Grid Padding="10">
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="80" HeightRequest="80"/>

        <CollectionView ItemsSource="{Binding Scenes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Scene">
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 8" Margin="0,4" Padding="12,10" Stroke="Grey">
                        <Grid ColumnDefinitions="*,auto">
                            <Label Grid.Column="0" Text="{Binding Title}" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Source={RelativeSource AncestorType={x:Type local:PlaySceneViewModel}}, Path=Loc.BtnLaunch}"
                                   FontSize="14" VerticalOptions="Center" TextColor="LightSkyBlue" Margin="8,0,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlaySceneViewModel}}, Path=LaunchCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
