<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.Campaigns"
             xmlns:models="clr-namespace:DmToolsApp.Models"
             xmlns:icons="clr-namespace:DmToolsApp.Resources.Icons"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             xmlns:tutorial="clr-namespace:DmToolsApp.Components.Tutorial"
             x:Class="DmToolsApp.Features.Campaigns.SceneListPage"
             x:DataType="local:SceneListViewModel"
             Title="{Binding PageTitle}">

    <Shell.TitleView>
        <Label Text="{Binding PageTitle}"
               FontSize="18" FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{DynamicResource AppTextPrimary}"/>
    </Shell.TitleView>

    <components:WatermarkedLayout>
    <Grid Padding="10" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Text="{loc:Loc ScenesHeader}" FontSize="20" Margin="0,0,0,8"/>

        <ActivityIndicator Grid.Row="1" Grid.RowSpan="2" IsRunning="{Binding Loading.IsLoading}"
                           IsVisible="{Binding Loading.IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           WidthRequest="80" HeightRequest="80"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Scenes}"
                        SelectedItem="{Binding SelectedScene}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Scene">
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 8" Margin="0,4" Padding="12,10"
                            MinimumHeightRequest="52">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="Grey"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="*,80">
                            <Label Grid.Column="0" Text="{Binding Title}" FontSize="16" VerticalOptions="Center"/>
                            <tutorial:TutorialCoachMark Grid.Column="1"
                                    IsActive="{Binding Source={RelativeSource AncestorType={x:Type local:SceneListViewModel}}, Path=ShowLaunchHint}"
                                    HintTitle="{Binding Source={RelativeSource AncestorType={x:Type local:SceneListViewModel}}, Path=TutorialHintTitle}"
                                    HintDescription="{Binding Source={RelativeSource AncestorType={x:Type local:SceneListViewModel}}, Path=TutorialHintDescription}"
                                    SkipCommand="{Binding Source={RelativeSource AncestorType={x:Type local:SceneListViewModel}}, Path=SkipTutorialCommand}">
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:SceneListViewModel}}, Path=LaunchCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="{loc:Loc BtnLaunch}"
                                           FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{DynamicResource AppAccent}"/>
                                </Grid>
                            </tutorial:TutorialCoachMark>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Voile qui assombrit la liste pendant l'étape "créer une scène". -->
        <BoxView Grid.Row="1" Color="Black" Opacity="0.55"
                 InputTransparent="True"
                 IsVisible="{Binding ShowCreateHint}"/>

        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0,8">
            <tutorial:TutorialCoachMark IsActive="{Binding ShowCreateHint}"
                                         HintTitle="{Binding TutorialHintTitle}"
                                         HintDescription="{Binding TutorialHintDescription}"
                                         SkipCommand="{Binding SkipTutorialCommand}">
                <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Plus}"
                                             Command="{Binding CreateCommand}"
                                             Tooltip="{loc:Loc BtnNewScene}"/>
            </tutorial:TutorialCoachMark>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Pen}"
                                         Command="{Binding RenameCommand}"
                                         Tooltip="{loc:Loc BtnRename}"
                                         Opacity="{Binding ShowCreateHint, Converter={StaticResource BoolToDimOpacityConverter}}"
                                         IsEnabled="{Binding SelectedScene, Converter={StaticResource IsNotNullConverter}}"/>
            <components:FaIconButtonView Icon="{x:Static icons:SolidFont.Trash}"
                                         Command="{Binding DeleteCommand}"
                                         Tooltip="{loc:Loc BtnDelete}"
                                         Opacity="{Binding ShowCreateHint, Converter={StaticResource BoolToDimOpacityConverter}}"
                                         IsEnabled="{Binding SelectedScene, Converter={StaticResource IsNotNullConverter}}"/>
        </HorizontalStackLayout>
    </Grid>
    </components:WatermarkedLayout>
</ContentPage>
