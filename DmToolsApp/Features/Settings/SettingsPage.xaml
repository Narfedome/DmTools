<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DmToolsApp.Features.Settings"
             xmlns:loc="clr-namespace:DmToolsApp.Extensions"
             xmlns:components="clr-namespace:DmToolsApp.Components"
             x:Class="DmToolsApp.Features.Settings.SettingsPage"
             x:DataType="local:SettingsViewModel"
             Title="{loc:Loc SettingsTitle}">

    <Shell.TitleView>
        <Label Text="{loc:Loc SettingsTitle}"
               FontSize="18" FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{DynamicResource AppTextPrimary}"/>
    </Shell.TitleView>

    <components:WatermarkedLayout>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Langue -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,auto">
                    <Label Grid.Column="0" Text="{loc:Loc SettingsLanguage}"
                           VerticalOptions="Center" FontSize="16"/>
                    <Button Grid.Column="1"
                            x:Name="LanguageButton"
                            Text="{Binding SelectedLanguageLabel}"
                            Clicked="OnLanguageClicked"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppAccent}"
                            FontSize="15"
                            Padding="8,4"/>
                </Grid>
            </Border>

            <!-- Thème -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,auto">
                    <Label Grid.Column="0" Text="{loc:Loc SettingsTheme}"
                           VerticalOptions="Center" FontSize="16"/>
                    <Button Grid.Column="1"
                            Text="{Binding SelectedThemeOption}"
                            Clicked="OnThemeClicked"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppAccent}"
                            FontSize="15"
                            Padding="8,4"/>
                </Grid>
            </Border>

            <!-- Palette -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Loc SettingsPalette}" FontSize="16"/>
                    <components:PalettePickerView
                        SelectedPalette="{Binding SelectedPalette, Mode=TwoWay}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Version -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,auto">
                    <Label Grid.Column="0" Text="{loc:Loc SettingsVersion}"
                           VerticalOptions="Center" FontSize="16"/>
                    <Label Grid.Column="1" Text="{Binding AppVersion}"
                           VerticalOptions="Center" FontSize="14"
                           TextColor="{DynamicResource AppSecondary}"/>
                </Grid>
            </Border>

            <!-- Test loading indicator -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,auto">
                    <Label Grid.Column="0" Text="Test loading indicator"
                           VerticalOptions="Center" FontSize="16"
                           TextColor="{DynamicResource AppSecondary}"/>
                    <Button Grid.Column="1" Text="⏳ Test"
                            Command="{Binding TestLoadingCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppAccent}"
                            FontSize="15" Padding="8,4"/>
                </Grid>
            </Border>

            <!-- Buy Me a Coffee -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="{loc:Loc SettingsSupportTitle}" FontSize="16"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{loc:Loc SettingsSupportDesc}"
                           TextColor="{DynamicResource AppAccent}"
                           FontSize="14"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCoffeeTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    </components:WatermarkedLayout>
</ContentPage>
