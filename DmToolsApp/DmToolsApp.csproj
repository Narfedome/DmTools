<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>DmToolsApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- NU1903: vulnérabilité connue SQLitePCLRaw, mise à jour bloquée par dépendances transitives -->
		<!-- MVVMTK0045: partial properties AOT - refactoring trop large, pas de cible WinRT stricte -->
		<NoWarn>$(NoWarn);NU1903;MVVMTK0045</NoWarn>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>DM Tools</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.dmtoolsapp</ApplicationId>

		<!-- Versions — patch auto-incrémenté via git au build, major/minor à la main -->
		<AppVersionMajor>0</AppVersionMajor>
		<AppVersionMinor>0</AppVersionMinor>
		<ApplicationDisplayVersion>$(AppVersionMajor).$(AppVersionMinor).0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1C1A2E" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1C1A2E" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="CommunityToolkit.Maui.Core" Version="14.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Components\TrackButton\TrackButtonView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\ChannelStrip\ChannelStripView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\LibraryItemImage\LibraryItemImageView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\FaIconButton\FaIconButtonView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\ScrollingLabel\ScrollingLabelView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\AudioMixer\AudioMixerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellSelectorPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackSelectorPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\LibrarySpellView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Spell\CreateEdit\LibrarySpellEditPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\CreateEdit\LibraryTrackEditPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Library\Track\LibraryTrackView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Resources\Styles\Icons.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Strings\AppStrings.resx" />
	  <EmbeddedResource Update="Strings\AppStrings.en.resx">
	    <Culture>en</Culture>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Data\Repositories\" />
	  <Folder Include="Features\CharacterTool\" />
	  <Folder Include="Selectors\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Components\TrackButton\TrackButtonView.xaml.cs">
	    <DependentUpon>TrackButtonView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Components\LibraryItemImage\LibraryItemImageView.xaml.cs">
	    <DependentUpon>LibraryItemImageView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\AudioMixer\AudioMixerPage.xaml.cs">
	    <DependentUpon>AudioMixerPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Spell\LibrarySpellSelectorPage.xaml.cs">
	    <DependentUpon>LibrarySpellSelectorPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Track\LibraryTrackSelectorPage.xaml.cs">
	    <DependentUpon>LibraryTrackSelectorPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Spell\LibrarySpellView.xaml.cs">
	    <DependentUpon>LibrarySpellView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Library\Track\LibraryTrackView.xaml.cs">
	    <DependentUpon>LibraryTrackView.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\AppIcon\appicon.svg">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Update="Resources\Images\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>


	<!-- Auto-incrémente le patch en comptant les commits git sur la branche courante -->
	<Target Name="SetVersionFromGit" BeforeTargets="Build">
		<Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
		</Exec>
		<PropertyGroup Condition="'$(_GitCommitCount)' != ''">
			<ApplicationDisplayVersion>$(AppVersionMajor).$(AppVersionMinor).$(_GitCommitCount.Trim())</ApplicationDisplayVersion>
			<ApplicationVersion>$(_GitCommitCount.Trim())</ApplicationVersion>
		</PropertyGroup>
		<Message Text="Version: $(ApplicationDisplayVersion)" Importance="high" />
	</Target>

</Project>
